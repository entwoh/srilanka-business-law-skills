{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/entwoh/srilanka-business-law-skills/ontology/node.schema.json",
  "title": "Compiled knowledge-graph node",
  "description": "One line of graph/nodes.jsonl. Generated by scripts/build_graph.py from an annotated H2 section; never hand-edited. See ontology/ontology.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "summary", "skill", "file", "line_start", "line_end", "edges", "verified", "source", "status", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(\\.[a-z0-9][a-z0-9-]*){1,2}$",
      "description": "Permanent node ID. Never renamed or reused."
    },
    "type": {
      "enum": ["statute", "regulator", "form", "entity_type", "concept", "obligation", "deadline", "procedure", "penalty", "rate", "playbook"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160, "description": "H2 heading text without the {#id} anchor." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200, "description": "The section's TL;DR line." },
    "skill": {
      "enum": ["company-formation", "company-secretarial", "shares-and-capital", "commercial-contracts", "employment-law", "tax-compliance", "foreign-investment", "intellectual-property", "data-protection", "dispute-resolution", "shared", "playbooks"],
      "description": "Owning skill folder, or 'shared' for shared/entities, or 'playbooks'."
    },
    "file": { "type": "string", "pattern": "^(skills|shared|playbooks)/.+\\.md$", "description": "Repo-relative path of the source Markdown." },
    "line_start": { "type": "integer", "minimum": 1, "description": "Line of the H2 heading (1-based)." },
    "line_end": { "type": "integer", "minimum": 1, "description": "Last line of the section, inclusive." },
    "edges": {
      "type": "object",
      "description": "Outbound edges declared on this node, by edge type. Targets may carry a '#pinpoint' (CITES only).",
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["CITES", "ADMINISTERED_BY", "REQUIRES_FORM", "HAS_DEADLINE", "APPLIES_TO", "TRIGGERS", "PREREQUISITE_OF", "DEFINED_IN", "PENALISED_BY", "AMENDED_BY", "SUPERSEDES", "RELATED", "STEP_OF"]
      },
      "patternProperties": {
        ".*": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9][a-z0-9-]*){1,2}(#[A-Za-z0-9-]+)?$" }
        }
      }
    },
    "verified": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["current", "amended", "repealed", "proposed", "not_in_force"] },
    "verification": { "enum": ["verified", "partial", "needs-verification"] },
    "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "kind": { "enum": ["act", "ordinance", "law", "regulation", "gazette", "bill", "common-law", "authority", "court", "tribunal", "registry", "portal"] },
    "effective": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]+(\\.[a-z0-9][a-z0-9-]*){1,2}$" }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "rate" } } }, "then": { "required": ["effective"] } },
    { "if": { "properties": { "type": { "const": "playbook" } } }, "then": { "required": ["steps"] } },
    { "if": { "properties": { "type": { "enum": ["statute", "regulator"] } } }, "then": { "required": ["kind"] } },
    { "if": { "required": ["kind"] }, "then": { "properties": { "type": { "enum": ["statute", "regulator"] } } } }
  ]
}
